# Copy to .env.local and fill in. Every variable is validated at boot by
# src/lib/env.ts, which lists what is missing rather than failing later with
# an opaque error. Blank means "not provided" for every optional key.

# --- Supabase (required) ---------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Deployment ------------------------------------------------------------
# Public origin, no trailing slash. Builds the URLs a payment gateway returns to,
# and every canonical, sitemap and share-image URL. Must be the real https://
# domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Search engines (optional) ---------------------------------------------
# Ownership tokens from Google Search Console and Bing Webmaster Tools, using
# the "HTML tag" method. Blank emits no tag. See SEO.md.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Shared secret for the scheduled jobs. Also signs sandbox payment callbacks,
# which is why it must be at least 16 characters.
CRON_SECRET=

# --- Payments (optional; a provider without both keys is not offered) ------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_WEBHOOK_SECRET=
# Inferred from the secret key's prefix. Set only to assert an expectation.
CASHFREE_ENVIRONMENT=

# Non-production test gateway. Refuses to construct when NODE_ENV=production.
ENABLE_SANDBOX_PAYMENTS=true

# --- Marketplaces (optional; unset runs the mock transport) ---------------
SWIGGY_API_BASE_URL=
SWIGGY_API_KEY=
SWIGGY_WEBHOOK_SECRET=

ZOMATO_API_BASE_URL=
ZOMATO_API_KEY=
ZOMATO_WEBHOOK_SECRET=

# --- Notifications (optional; console logs instead of sending) ------------
NOTIFICATION_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# --- Development aids (explicit switches; unset them before going live) ----
# Lists the seeded accounts on the sign-in page.
SHOW_DEMO_ACCOUNTS=false
DEMO_ACCOUNT_PASSWORD=
# Enables the "Test order" button on the KOT manager screen and its endpoint.
SHOW_DEV_TOOLS=false

# --- Private development lock ---------------------------------------------
# While 'true' (the default when unset), the whole site answers only to
# Developer Admin accounts and the addresses below; everyone else is sent to
# sign-in. Set to 'false' to launch. Exact addresses only, comma-separated.
# The demo-accounts panel on the sign-in page is hidden while this is on.
SITE_LOCKED=true
SITE_LOCK_ALLOWED_EMAILS=owner@cloudkitchen.test,manager@cloudkitchen.test,kitchen1@cloudkitchen.test,kitchen2@cloudkitchen.test,kitchen3@cloudkitchen.test,meera@example.test,rahul@example.test,sana@example.test
