  {
   "type": "text",
   "id": "subtitle",
   "x": 60,
   "y": 108,
   "width": 1100,
   "height": 22,
   "text": "Three state machines, deliberately separate. Neither owns the other's columns.",
   "originalText": "Three state machines, deliberately separate. Neither owns the other's columns.",
   "fontSize": 17,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "strokeColor": "#386155",
   "backgroundColor": "transparent",
